# SMTP settings for the LTI AI Grader monitoring e-mails (weekly report and watchdog alerts).
#
# Copy to /etc/lti-health/mail.env, chmod 600, and fill in the values.
# E-mail stays DISABLED while MAIL_TO, MAIL_FROM or SMTP_HOST are empty:
# reports are still written to /var/log/lti-health, nothing is sent.
#
# Do not commit /etc/lti-health/mail.env or real credentials to Git.

MAIL_TO=
MAIL_FROM=
SMTP_HOST=

# Port 587 + STARTTLS is the usual setup; for implicit TLS use SMTP_SSL=true and SMTP_PORT=465.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=20

# Example:
#   MAIL_TO=admin@example.org
#   MAIL_FROM=lti-health@example.org
#   SMTP_HOST=smtp.example.org
#   SMTP_USER=example-user
#   SMTP_PASSWORD=change-me

# AI provider alert (lti-health-ai-watch.timer, runs every 5 minutes): an e-mail is sent when this many
# AI calls in a row fail, all within the window below, and another when a call succeeds again.
# These are the defaults; uncomment to change them.
#AI_ALERT_CONSECUTIVE=3
#AI_ALERT_WINDOW_MIN=30

# Watchdog (lti-health-watchdog.timer, runs every 5 minutes). It e-mails when the list of detected
# problems changes, and again when it is empty. To see what it would report without sending anything
# or changing any state (repeat your own values for the variables below):
#   sudo env LTI_HEALTH_DRYRUN=1 TLS_HOST=yourserver.com /usr/local/sbin/lti-health-watchdog.sh
#
# TLS checks are OFF until TLS_HOST is set. They look at the certificate that is really SERVED on the
# HTTPS port (not only at the file on disk): it must answer, expire in more than TLS_WARN_DAYS days,
# verify for TLS_HOST, and be the same certificate as CERT_FILE (a renewed file that nginx has not reloaded).
#TLS_HOST=yourserver.com
#TLS_CONNECT=127.0.0.1
#TLS_PORT=443
#TLS_WARN_DAYS=21              # one e-mail when fewer days are left...
#TLS_CRIT_DAYS=7               # ...then one e-mail per day when fewer than this
#TLS_VERIFY=1                  # 0 if the certificate comes from a CA that this server does not trust
#TLS_CAFILE=                   # extra CA bundle used for that verification
#CERT_FILE=/etc/ssl/yourserver/fullchain.pem
#CERT_RELOAD_GRACE_MIN=10      # minutes allowed between writing CERT_FILE and reloading nginx
#WATCHDOG_FAILS_BEFORE_ALERT=2 # consecutive failed HTTPS checks (5 min apart) before alerting

# Resource alerts (always on): samples are taken every 30 s from the metrics CSV.
#MEM_ALERT_MB=300              # available memory below this...
#MEM_ALERT_SAMPLES=4           # ...in at least this many samples (2 minutes)...
#ALERT_WINDOW_MIN=15           # ...within the last this many minutes
#LOAD_ALERT=20                 # 1-minute load average above this (0 disables)
#LOAD_ALERT_SAMPLES=4
